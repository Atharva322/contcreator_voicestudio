{
  "name": "creator-voice-studio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run lint",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --reload --port 8000",
    "test:api": "python -m pytest apps/api/tests -q",
    "smoke:api": "python scripts/smoke_test.py",
    "verify": "node scripts/verify.mjs",
    "db:upgrade": "python -m alembic -c apps/api/alembic.ini upgrade head",
    "db:current": "python -m alembic -c apps/api/alembic.ini current",
    "db:check": "python scripts/db_check.py",
    "demo:seed": "python scripts/seed_demo.py",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1"
  }
}
